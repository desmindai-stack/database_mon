# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres — use Session pooler URI (IPv4) for SQLAlchemy worker/API
# Settings → Database → Connection string → URI (mode: session)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Worker / API split (cloud)
# Local dev: all | Production API: api | Production collector: worker
RUN_MODE=all

COLLECT_INTERVAL_SECONDS=15
CREDENTIALS_MASTER_KEY=change-me-long-random-secret

# Public = multi-customer dashboard; private = single-customer isolated install
DEPLOYMENT_MODE=public
DEFAULT_CUSTOMER_NAME=

# CORS (Vercel dashboard URL)
CORS_ORIGINS=["https://your-dashboard.vercel.app","http://localhost:5173"]

# Auth (Faz 15 İŞ 1) — JWT_SECRET MUST be a long random value in production, or every
# deployment shares the same insecure dev default and tokens become forgeable.
JWT_SECRET=change-me-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# First-boot admin bootstrap — only used once, when the users table is empty. Leave
# ADMIN_PASSWORD unset to have one generated and logged on first startup instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
