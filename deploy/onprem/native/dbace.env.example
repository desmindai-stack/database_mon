# dbace — tek Linux sunucu, Docker'sız on-prem (internete kapalı) — Faz 32 Commit 11b
#
# install.sh bu dosyayı /etc/dbace/dbace.env'e (ilk kurulumda) kopyalar; sonraki her install.sh
# (yükseltme) çalıştırmasında dosya OLDUĞU GİBİ korunur — yalnızca eksik ZORUNLU değerler üretilir.
# Aşağıdaki değişkenler backend/app/config.py::Settings ile birebir (Docker paketindeki .env.example'la
# aynı disiplin — tests/test_onprem_package_drift.py'nin native karşılığı ayrı bir işte eklenecek).

# --- ZORUNLU (boş/placeholder bırakılırsa install.sh OTOMATİK ÜRETİR) --------------------------

# dbace'in kendi (meta) veritabanı şifresi — izlediğiniz DB'ler DEĞİL.
DBACE_DB_PASSWORD=
# İzlenen veritabanlarının bağlantı şifrelerini şifreler. Değişirse kayıtlı şifreler okunamaz — YEDEKLEYİN.
CREDENTIALS_MASTER_KEY=
# Oturum jetonlarını imzalar.
JWT_SECRET=
# İlk yönetici şifresi (kullanıcı adı ADMIN_USERNAME) — üretilirse kurulum sonunda BİR KEZ ekrana yazılır.
ADMIN_PASSWORD=

# --- Ağ --------------------------------------------------------------------------------------

# TLS_MODE=nginx (varsayılan): nginx bankanın sertifikasıyla HTTPS'i kendisi sonlandırır (/etc/dbace/tls/).
# TLS_MODE=backend: bankanın önünde zaten TLS sonlandıran bir LB/WAF varsa — nginx düz HTTP'de dinler.
TLS_MODE=nginx
HTTP_PORT=8080
HTTPS_PORT=443
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
API_HOST=127.0.0.1
API_PORT=8000

# --- Kurulum biçimi --------------------------------------------------------------------------

DEPLOYMENT_MODE=public
DEFAULT_CUSTOMER_NAME=
RUN_MODE=all
APP_NAME=dbace
ADMIN_USERNAME=admin
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# --- Toplama ve zamanlama -------------------------------------------------------------------

COLLECT_INTERVAL_SECONDS=15
SLOW_QUERY_INTERVAL_SECONDS=300
WAIT_SAMPLING_ENABLED=true
WAIT_SAMPLE_INTERVAL_SECONDS=1
WAIT_STATS_BASELINE=shared
BACKUP_MONITORING_ENABLED=true
BACKUP_CHECK_INTERVAL_SECONDS=900
PLAN_CAPTURE_ENABLED=true
PLAN_CAPTURE_INTERVAL_SECONDS=300
INDEX_ADVICE_WATCH_INTERVAL_SECONDS=300
DASHBOARD_REFRESH_INTERVAL_SECONDS=60
DB_STATEMENT_TIMEOUT_SECONDS=120

# --- Yerel yedekleme (dbace-backup.service + .timer — docs/ONPREM_NATIVE.md §2) -----------------

# pg_dump -Fc çıktısının yazılacağı dizin (dbace kullanıcısı yazabilmeli).
BACKUP_DIR=/var/backups/dbace
# Kaç gün saklanacağı (mtime tabanlı budama). Not: BACKUP_MIN_RETENTION_DAYS (60, retention.py) uygulamanın
# KENDİ yedek KAYITLARI içindir — bu, dosya sistemindeki pg_dump çıktısının saklama süresi, AYRI bir kavram.
BACKUP_RETENTION_DAYS=14

# --- Kullanılmıyor (bulut) -------------------------------------------------------------------

# DATABASE_URL install.sh tarafından DBACE_DB_PASSWORD'den kuruluyor; burada vermeyin.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY kodda okunmuyor; boş kalır.
