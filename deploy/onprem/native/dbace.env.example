# dbace - single Linux server, Docker-less on-prem (no internet) - Phase 32 Commit 11b
#
# install.sh copies this file to /etc/dbace/dbace.env on first install; every later install.sh
# (upgrade) run PRESERVES the file AS-IS - only missing REQUIRED values are generated.
# The variables below match backend/app/config.py::Settings one-to-one (same discipline as the
# Docker package's .env.example - a native counterpart of tests/test_onprem_package_drift.py will
# be added in a separate piece of work).

# --- REQUIRED (left empty/placeholder, install.sh GENERATES them automatically) ----------------

# dbace's own (meta) database password - NOT the databases you monitor.
DBACE_DB_PASSWORD=
# Encrypts the connection passwords of monitored databases. If it changes, stored passwords
# can no longer be decrypted - BACK IT UP.
CREDENTIALS_MASTER_KEY=
# Signs session tokens.
JWT_SECRET=
# Initial admin password (username ADMIN_USERNAME) - if generated, printed ONCE at the end of install.
ADMIN_PASSWORD=

# --- Network -------------------------------------------------------------------------------

# TLS_MODE=nginx (default): nginx terminates HTTPS itself with the bank's certificate (/etc/dbace/tls/).
# TLS_MODE=backend: an LB/WAF in front of the bank's network already terminates TLS - nginx listens plain HTTP.
TLS_MODE=nginx
HTTP_PORT=8080
HTTPS_PORT=443
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
API_HOST=127.0.0.1
API_PORT=8000

# --- Deployment shape ------------------------------------------------------------------------

DEPLOYMENT_MODE=public
DEFAULT_CUSTOMER_NAME=
RUN_MODE=all
APP_NAME=dbace
ADMIN_USERNAME=admin
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# --- Collection and scheduling ----------------------------------------------------------------

COLLECT_INTERVAL_SECONDS=15
SLOW_QUERY_INTERVAL_SECONDS=300
WAIT_SAMPLING_ENABLED=true
WAIT_SAMPLE_INTERVAL_SECONDS=1
WAIT_STATS_BASELINE=shared
BACKUP_MONITORING_ENABLED=true
BACKUP_CHECK_INTERVAL_SECONDS=900
PLAN_CAPTURE_ENABLED=true
PLAN_CAPTURE_INTERVAL_SECONDS=300
INDEX_ADVICE_WATCH_INTERVAL_SECONDS=300
DASHBOARD_REFRESH_INTERVAL_SECONDS=60
DB_STATEMENT_TIMEOUT_SECONDS=120

# --- Local backup (dbace-backup.service + .timer - docs/ONPREM_NATIVE.md section 2) ------------

# Directory the pg_dump -Fc output is written to (the dbace user must be able to write here).
BACKUP_DIR=/var/backups/dbace
# How many days to keep (mtime-based pruning). Note: BACKUP_MIN_RETENTION_DAYS (60, retention.py)
# is for the application's OWN backup RECORDS - this is the retention of the filesystem pg_dump
# output, a SEPARATE concept.
BACKUP_RETENTION_DAYS=14

# --- Unused (cloud) --------------------------------------------------------------------------

# DATABASE_URL is built by install.sh from DBACE_DB_PASSWORD; do not set it here.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are not read by the code; leave empty.
