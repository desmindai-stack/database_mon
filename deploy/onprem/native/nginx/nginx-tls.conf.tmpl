# TLS_MODE=nginx (default) - nginx terminates HTTPS itself using the bank's certificate.
# install.sh fills in the __HTTP_PORT__ / __HTTPS_PORT__ / __API_PORT__ / __WEB_ROOT__ placeholders.
server {
    listen __HTTP_PORT__;
    server_name _;
    return 301 https://$host:__HTTPS_PORT__$request_uri;
}

server {
    listen __HTTPS_PORT__ ssl;
    server_name _;
    root __WEB_ROOT__;
    index index.html;

    ssl_certificate     /etc/dbace/tls/fullchain.pem;
    ssl_certificate_key /etc/dbace/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs {
        proxy_pass http://127.0.0.1:__API_PORT__/docs;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        proxy_pass http://127.0.0.1:__API_PORT__/openapi.json;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
