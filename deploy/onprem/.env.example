# dbace — tek Linux sunucu, on-prem (internete kapalı)
# Kopyalayın: cp .env.example .env  → değerleri düzenleyin
#
# Faz 31 Commit 8: uygulamanın BÜTÜN ayarları burada (backend/app/config.py::Settings ile birebir —
# tests/test_onprem_package_drift.py denetliyor). "ZORUNLU" olanlar verilmezse yığın başlamaz.

# --- ZORUNLU ---------------------------------------------------------------------------------

# Uygulama veritabanı şifresi (metrikler + instance kayıtları — izlediğiniz DB'ler değil)
DBACE_DB_PASSWORD=degistirin_guclu_sifre
# İzlenen veritabanlarının bağlantı şifrelerini şifreler. Değişirse kayıtlı şifreler okunamaz — YEDEKLEYİN.
CREDENTIALS_MASTER_KEY=degistirin_en_az_32_karakter_rastgele_anahtar
# Oturum jetonlarını imzalar. Verilmezse koddaki geliştirme sırrı kullanılırdı (jeton taklit edilebilir).
# Üretmek için: openssl rand -hex 32
JWT_SECRET=degistirin_openssl_rand_hex_32
# İlk yönetici şifresi (kullanıcı adı ADMIN_USERNAME). İlk girişte değiştirmeniz istenir.
ADMIN_PASSWORD=degistirin_ilk_yonetici_sifresi

# --- Ağ --------------------------------------------------------------------------------------

# Web arayüzü portu (sunucuda: http://SUNUCU_IP:8080)
HTTP_PORT=8080
# Tarayıcının arayüzü açtığı adres(ler) — JSON listesi
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
# API sürecinin dinlediği adres/port (konteyner içi; değiştirmeyin)
API_HOST=0.0.0.0
API_PORT=8000

# --- Kurulum biçimi --------------------------------------------------------------------------

# public = çok müşterili dashboard; private = tek müşterili izole kurulum
DEPLOYMENT_MODE=public
DEFAULT_CUSTOMER_NAME=
# all = API + toplayıcı tek süreçte (on-prem varsayılanı); api / worker ayrı süreç
RUN_MODE=all
APP_NAME=dbace
ADMIN_USERNAME=admin
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# --- Toplama ve zamanlama -------------------------------------------------------------------

# Metrik toplama aralığı (saniye)
COLLECT_INTERVAL_SECONDS=15
# Yavaş sorgu (pg_stat_statements / DMV) toplama aralığı (saniye)
SLOW_QUERY_INTERVAL_SECONDS=300
# Bekleme (wait event) örnekleyicisi
WAIT_SAMPLING_ENABLED=true
WAIT_SAMPLE_INTERVAL_SECONDS=1
# Yedek izleme
BACKUP_MONITORING_ENABLED=true
BACKUP_CHECK_INTERVAL_SECONDS=900
# auto_explain plan yakalama (host-agent gerekir)
PLAN_CAPTURE_ENABLED=true
PLAN_CAPTURE_INTERVAL_SECONDS=300
# Index önerisi eşik izleme turu
INDEX_ADVICE_WATCH_INTERVAL_SECONDS=300
# Dashboard özet yenileme
DASHBOARD_REFRESH_INTERVAL_SECONDS=60
# dbace'in KENDİ veritabanı sorgu zaman aşımı (saniye; izlenen DB'leri etkilemez)
DB_STATEMENT_TIMEOUT_SECONDS=120

# --- Kullanılmıyor (bulut) -------------------------------------------------------------------

# DATABASE_URL docker-compose.yml içinde DBACE_DB_PASSWORD'den kuruluyor; burada vermeyin.
# DATABASE_URL=
# Supabase ayarları kodda OKUNMUYOR (Commit 8 envanteri); on-prem'de boş kalır.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
